          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response has access_token and refresh_token\", () => {",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.expect(json.access_token).to.be.a(\"string\").and.to.not.be.empty;",
                  "    pm.expect(json).to.have.property(\"refresh_token\");",
                  "});",
                  "// if response successfull set variables for later use",
                  "if (pm.response.code === 201 && json.access_token && json.refresh_token) {",
                  "    pm.collectionVariables.set(\"accessToken\", json.access_token);",
                  "    pm.collectionVariables.set(\"refreshToken\", json.refresh_token);",
                  "} else {",
                  "    console.log(\"Failed to set variables\");",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
