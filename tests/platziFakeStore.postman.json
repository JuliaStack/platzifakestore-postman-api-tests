                  "",
                  "function checkProduct(product, label) {",
                  "    pm.expect(product.id, `${label}.id`).to.be.a('number');",
                  "    pm.expect(product.title, `${label}.title`).to.be.a('string').and.to.not.be.empty;",
                  "    pm.expect(product.price, `${label}.price`).to.be.a('number').and.to.be.above(0);",
                  "    pm.expect(product.description, `${label}.description`).to.be.a('string').and.to.not.be.empty;",
                  "    pm.expect(product.category, `${label}.category`).to.be.an('object');",
                  "    pm.expect(product.category.id, `${label}.category.id`).to.be.a('number');",
                  "    pm.expect(product.category.name, `${label}.category.name`).to.be.a('string').and.to.not.be.empty;",
                  "    pm.expect(product.images, `${label}.images`).to.be.an('array').that.has.length.at.least(1);",
                  "}",
                  "",
                  "pm.test('Response matches product shape', () => {",
                  "    const json = pm.response.json();",
                  "    if (Array.isArray(json)) {",
                  "        pm.expect(json).to.not.be.empty;",
                  "        json.forEach((product, i) => checkProduct(product, `product[${i}]`));",
                  "    } else {",
                  "        checkProduct(json, 'product');",
                  "    }",
                  "});"
