                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const uniqueSlug = `${Date.now()}`;",
                      "",
                      "pm.sendRequest({",
                      "    url: pm.collectionVariables.get('baseUrl') + '/api/v1/products',",
                      "    method: 'POST',",
                      "    header: { 'Content-Type': 'application/json' },",
                      "    body: {",
                      "        mode: 'raw',",
                      "        raw: JSON.stringify({",
                      "            title: 'New Product ' + uniqueSlug,",
                      "            slug: uniqueSlug,",
                      "            price: 111,",
                      "            description: 'A description for the new product',",
                      "            categoryId: 1,",
                      "            images: [",
                      "                'https://placehold.co/600x400',",
                      "                'https://image-1.co/600x400'",
                      "            ]",
                      "        })",
                      "    }",
                      "}, (err, response) => {",
                      "    if (err) {",
                      "        pm.execution.setNextRequest(null);",
                      "        return;",
                      "    }",
                      "",
                      "    const json = response.json();",
                      "    if (response.code === 201 && typeof json.id === 'number') {",
                      "        pm.collectionVariables.set('createdProductId', json.id);",
                      "    } else {",
                      "        pm.execution.setNextRequest(null);",
